{
  "name": "reparobot",
  "version": "1.0.0",
  "author": "Charles HL",
  "license": "Copyright © All Rights Reserved Charles HILD LÊ",
  "private": true,
  "scripts": {
    "memory:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/agent-memory/check.ts",
    "memory:impact": "node tools/agent-memory/impact.ts",
    "prepare": "husky install",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:staged": "eslint --fix",
    "format:check": "prettier \"**/*.+(json|ts|tsx)\" --check",
    "format:fix": "prettier \"**/*.+(json|ts|tsx)\" --write",
    "format:staged": "prettier --write",
    "types:check": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint && pnpm run types:check",
    "fix": "pnpm run lint:fix && pnpm run types:check && pnpm run format:fix",
    "predev": "pnpm run check",
    "dev": "next dev --port 3005",
    "prebuild": "pnpm run check",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true pnpm run build",
    "start:prod": "pnpm run build && pnpm run start"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.1",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.33.0"
}
