{
  "name": "reparobot",
  "version": "1.0.0",
  "author": "Charles HL",
  "license": "Copyright © All Rights Reserved Charles HILD LÊ",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:staged": "eslint --fix",
    "format:check": "prettier \"**/*.+(json|ts|tsx)\" --check",
    "format:fix": "prettier \"**/*.+(json|ts|tsx)\" --write",
    "format:staged": "prettier --write",
    "types:check": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run types:check",
    "fix": "npm run lint:fix && npm run types:check && npm run format:fix",
    "predev": "npm run check",
    "dev": "next dev --port 3005",
    "prebuild": "npm run check",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true npm run build",
    "start:prod": "npm run build && npm run start"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-countup": "^6.4.2",
    "react-dom": "19.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.1",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.24",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.35.1",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
