# API forestar-server (catalogue, devis, formulaires). Les images en dépendent aussi
# (next.config.js en tire l'hôte autorisé, chemin /images/**).
API_URL=https://api.forestar.be
AUTH_TOKEN=your_auth_token
NODE_ENV=development
REVALIDATE_SECRET=your_revalidate_secret

# URL publique du site : métadonnées, canonical, JSON-LD, plan du site (lib/site.ts).
# Défaut : https://www.reparobot.be. En aperçu ou si le domaine change, à poser avant le build.
SITE_URL=https://www.reparobot.be

# Turnstile (anti-robot des formulaires) : clé PUBLIQUE du widget, lue par le navigateur.
# Sans elle le widget ne s'affiche pas et le serveur refuse les envois. La clé secrète
# n'est pas ici : elle vit dans forestar-server, qui vérifie le jeton (D-04).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Mesure d'audience GA4 (R004). Sans identifiant valide : ni bandeau, ni script, ni traceur.
# Format G-XXXXXXXXXX (le gabarit lui-même est refusé). Figée au build : à poser avant le déploiement.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
